# Copy this file to .streamlit/secrets.toml and fill in the values from
# Supabase Dashboard → Project Settings → API.
# Use the Publishable key (or legacy anon key), never the service_role key.

SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_KEY = "your-publishable-or-anon-key"

# Add this exact address to Supabase Dashboard → Authentication → URL Configuration
AUTH_REDIRECT_URL = "http://localhost:8501"
